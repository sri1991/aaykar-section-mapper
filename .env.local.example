# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # only needed for ingestion script

# Auth: Google OAuth — enable at Supabase Dashboard → Auth → Providers → Google
# Add OAuth credentials from: console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: https://your-project.supabase.co/auth/v1/callback

# Google AI — https://aistudio.google.com/app/apikey
# Used for text-embedding-004 (768-dim, free tier: 1500 req/day)
GOOGLE_API_KEY=your-google-api-key

# Cohere — https://dashboard.cohere.com/api-keys
# Used for rerank-english-v3.0 (free tier: 1000 calls/month)
COHERE_API_KEY=your-cohere-api-key

# Groq — https://console.groq.com/keys
# Used for llama-3.3-70b-versatile generation (free tier: 14,400 req/day)
GROQ_API_KEY=your-groq-api-key
