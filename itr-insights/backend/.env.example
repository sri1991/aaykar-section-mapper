# Copy to .env and fill in. Never commit .env.

# Which provider to use. One of: gemini
LLM_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=
GEMINI_EXTRACT_MODEL=gemini-2.5-flash
GEMINI_NARRATE_MODEL=gemini-2.5-pro

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# CORS (comma-separated origins for the frontend during local dev)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
